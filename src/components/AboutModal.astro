---
// src/components/AboutModal.astro — Popup "À propos" TourData 2026 / OceanPhenix
---

<div id="about-modal" class="about-overlay" role="dialog" aria-modal="true" aria-labelledby="about-title" hidden>
  <div class="about-sheet">

    <!-- Handle + fermer -->
    <div class="about-handle"></div>
    <button class="about-close" id="about-close" aria-label="Fermer">
      <i class="fas fa-xmark"></i>
    </button>

    <!-- Hero -->
    <div class="about-hero">
      <div class="about-hero-icon">
        <i class="fas fa-bicycle"></i>
      </div>
      <div class="about-hero-text">
        <h2 id="about-title" class="about-title">TourData 2026</h2>
        <p class="about-tagline">2 500 km à vélo · France · Data &amp; Territoire</p>
      </div>
      <span class="about-badge"><i class="fas fa-circle-dot"></i> Avril 2026</span>
    </div>

    <div class="about-body">

      <!-- Qui -->
      <section class="about-section">
        <h3 class="about-section-title"><i class="fas fa-user"></i> Qui ?</h3>
        <p>
          <strong>Stéphane Celton</strong> — Data Product Manager, Senior Data Analyst BI,
          15&nbsp;ans d'expérience IT. Fondateur d'<strong>OceanPhenix™</strong>, spécialisé
          en solutions data souveraines, IA et Business Intelligence.
        </p>
      </section>

      <!-- Quoi -->
      <section class="about-section">
        <h3 class="about-section-title"><i class="fas fa-route"></i> Le projet TourData 2026</h3>
        <p>
          Un tour de France à vélo de <strong>2 500 km</strong>, du printemps à l'été 2026,
          à la rencontre des entreprises, collectivités et acteurs du territoire pour comprendre
          leurs <strong>besoins data réels</strong> — loin des conférences et des écrans.
        </p>
        <div class="about-kpi-row">
          <div class="about-kpi">
            <span class="about-kpi-val">2 500</span>
            <span class="about-kpi-lbl">km</span>
          </div>
          <div class="about-kpi">
            <span class="about-kpi-val">10+</span>
            <span class="about-kpi-lbl">étapes</span>
          </div>
          <div class="about-kpi">
            <span class="about-kpi-val">100+</span>
            <span class="about-kpi-lbl">rencontres</span>
          </div>
          <div class="about-kpi">
            <span class="about-kpi-val">3</span>
            <span class="about-kpi-lbl">mois</span>
          </div>
        </div>
      </section>

      <!-- Pourquoi -->
      <section class="about-section">
        <h3 class="about-section-title"><i class="fas fa-lightbulb"></i> Pourquoi ce site ?</h3>
        <ul class="about-list">
          <li><i class="fas fa-map-marker-alt"></i> <strong>Journal de terrain</strong> — étapes, rencontres, observations</li>
          <li><i class="fas fa-chart-pie"></i> <strong>Dashboard</strong> — suivi physique Strava, km parcourus</li>
          <li><i class="fas fa-crosshairs"></i> <strong>Radar Terrain</strong> — trouver campings, coworkings et entreprises data autour de sa position GPS</li>
          <li><i class="fas fa-fab fa-strava"></i> <strong>Strava live</strong> — activités et performance en temps réel</li>
        </ul>
      </section>

      <!-- Itinéraire -->
      <section class="about-section">
        <h3 class="about-section-title"><i class="fas fa-map"></i> Itinéraire prévu</h3>
        <div class="about-route">
          <span class="about-route-city about-route-start">Fontenay-lès-Briis</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Caen</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Rennes</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Nantes</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Bordeaux</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Toulouse</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Montpellier</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Marseille</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city">Nice</span>
          <i class="fas fa-arrow-right about-route-arrow"></i>
          <span class="about-route-city about-route-end">Lyon</span>
        </div>
      </section>

      <!-- Contact -->
      <section class="about-section about-section--contact">
        <a href="https://www.linkedin.com/in/stephane-celton" target="_blank" rel="noopener"
          class="about-cta">
          <i class="fab fa-linkedin"></i> Suivre sur LinkedIn
        </a>
        <a href="/terrain" class="about-cta about-cta--outline">
          <i class="fas fa-bicycle"></i> Voir le journal de terrain
        </a>
      </section>

    </div><!-- /.about-body -->
  </div><!-- /.about-sheet -->
</div><!-- /.about-overlay -->

<style>
/* ── Overlay ─────────────────────────────────────────────── */
.about-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.70);
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
.about-overlay[hidden] { display: none; }

/* ── Sheet ───────────────────────────────────────────────── */
.about-sheet {
  background: rgba(12, 22, 40, 0.97);
  border: 1px solid rgba(45, 130, 170, 0.2);
  border-bottom: none;
  border-radius: 24px 24px 0 0;
  width: 100%;
  max-width: 600px;
  max-height: 90dvh;
  overflow-y: auto;
  padding: 16px 22px 40px;
  position: relative;
  box-shadow: 0 -12px 48px rgba(0,0,0,.6);
  scrollbar-width: thin;
  scrollbar-color: rgba(77,184,212,.2) transparent;
}

.about-handle {
  width: 40px;
  height: 4px;
  background: rgba(77, 184, 212, 0.2);
  border-radius: 2px;
  margin: 0 auto 18px;
}

.about-close {
  position: absolute;
  top: 14px;
  right: 16px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: var(--text-muted);
  width: 30px;
  height: 30px;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  transition: var(--transition-fast);
}
.about-close:hover { background: rgba(255,255,255,.12); color: var(--text-light); }

/* ── Hero ────────────────────────────────────────────────── */
.about-hero {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 22px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(45, 130, 170, 0.12);
}

.about-hero-icon {
  width: 48px;
  height: 48px;
  background: rgba(226, 249, 76, 0.1);
  border: 1px solid rgba(226, 249, 76, 0.25);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e2f94c;
  font-size: 1.4rem;
  flex-shrink: 0;
}

.about-hero-text { flex: 1; min-width: 0; }

.about-title {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--text-light);
  margin: 0 0 2px;
  letter-spacing: -0.02em;
}

.about-tagline {
  font-size: var(--text-sm);
  color: var(--accent-cyan);
  margin: 0;
}

.about-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: var(--text-xs);
  background: rgba(61, 232, 160, 0.1);
  border: 1px solid rgba(61, 232, 160, 0.25);
  color: #3de8a0;
  padding: 4px 10px;
  border-radius: var(--radius-full);
}
.about-badge i { font-size: 0.55rem; animation: pulse-dot 1.5s ease infinite; }
@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:.3} }

/* ── Body ────────────────────────────────────────────────── */
.about-section {
  margin-bottom: 20px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(45, 130, 170, 0.08);
}
.about-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

.about-section-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--accent-cyan);
  text-transform: uppercase;
  letter-spacing: var(--ls-label);
  margin: 0 0 10px;
  display: flex;
  align-items: center;
  gap: 7px;
}
.about-section-title i { opacity: .8; }

.about-section p {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: var(--lh-body);
  margin: 0;
}
.about-section p strong { color: var(--text-light); }

/* KPI row */
.about-kpi-row {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  flex-wrap: wrap;
}
.about-kpi {
  flex: 1;
  min-width: 56px;
  background: rgba(12, 32, 56, 0.8);
  border: 1px solid rgba(45, 130, 170, 0.12);
  border-radius: var(--radius-md);
  padding: 10px 8px;
  text-align: center;
}
.about-kpi-val {
  display: block;
  font-size: var(--text-xl);
  font-weight: 700;
  color: #e2f94c;
  line-height: 1.1;
}
.about-kpi-lbl {
  display: block;
  font-size: 0.65rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-top: 2px;
}

/* Liste */
.about-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.about-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.4;
}
.about-list li i { color: var(--accent-cyan); margin-top: 2px; flex-shrink: 0; width: 14px; }
.about-list li strong { color: var(--text-light); }

/* Itinéraire */
.about-route {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 6px;
  font-size: var(--text-xs);
}
.about-route-city {
  padding: 3px 8px;
  border-radius: var(--radius-full);
  background: rgba(77, 184, 212, 0.08);
  border: 1px solid rgba(77, 184, 212, 0.18);
  color: var(--text-light);
  white-space: nowrap;
}
.about-route-start { border-color: rgba(226,249,76,.35); color: #e2f94c; background: rgba(226,249,76,.06); }
.about-route-end   { border-color: rgba(61,232,160,.35); color: #3de8a0; background: rgba(61,232,160,.06); }
.about-route-arrow { color: rgba(143,163,184,.35); font-size: 0.6rem; }

/* CTA contact */
.about-section--contact {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.about-cta {
  flex: 1;
  min-width: 140px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 600;
  font-family: var(--font-primary);
  text-decoration: none;
  transition: var(--transition-fast);
  cursor: pointer;
}
.about-cta { background: #0077b5; color: #fff; border: 1px solid #0077b5; }
.about-cta:hover { background: #005f94; }
.about-cta--outline {
  background: transparent;
  color: var(--text-light);
  border: 1px solid rgba(45, 130, 170, 0.3);
}
.about-cta--outline:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); }

/* Light theme */
[data-theme="light"] .about-sheet {
  background: rgba(234, 241, 247, 0.98);
  border-color: rgba(26, 127, 160, 0.2);
}
[data-theme="light"] .about-section p { color: #4a6275; }
[data-theme="light"] .about-section p strong { color: #1a2535; }
[data-theme="light"] .about-list li { color: #4a6275; }
[data-theme="light"] .about-list li strong { color: #1a2535; }
[data-theme="light"] .about-kpi { background: rgba(220,232,242,.8); }
[data-theme="light"] .about-route-city { color: #1a2535; }
</style>

<script is:inline>
(function () {
  function openAbout() {
    const m = document.getElementById('about-modal');
    if (m) { m.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; }
  }
  function closeAbout() {
    const m = document.getElementById('about-modal');
    if (m) { m.setAttribute('hidden', ''); document.body.style.overflow = ''; }
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Lien nav
    document.querySelectorAll('#about-link, .about-trigger').forEach(function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); openAbout(); });
    });
    // Fermer
    var btn = document.getElementById('about-close');
    if (btn) btn.addEventListener('click', closeAbout);
    // Clic overlay
    var overlay = document.getElementById('about-modal');
    if (overlay) overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeAbout();
    });
    // Echap
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAbout();
    });
  });
})();
</script>
