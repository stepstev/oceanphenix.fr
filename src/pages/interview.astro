---
// src/pages/interview.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import OceanBackground from '../components/OceanBackground.astro';
import Nav from '../components/Nav.astro';
import CguModal from '../components/CguModal.astro';

const STRAVA_API_BASE = import.meta.env.PUBLIC_STRAVA_API_BASE ?? 'https://goal.oceanphenix.fr';
const GOOGLE_FORM_URL = import.meta.env.PUBLIC_GOOGLE_FORM_URL ?? 'https://docs.google.com/forms/d/e/1FAIpQLSejj8GsxX9DiBXW3GreAufumNCGfKRoDrr7fDRt8cAEMcMdMA/viewform';
---

<BaseLayout
  title="Rencontrons-nous · Tour de la Data 2026 · OceanPhenix"
  description="Je réalise un tour de France vélo dédié à la Data & l'IA. Rencontrons-nous sur le terrain — entretiens, échanges, retours d'expérience."
  canonical="https://oceanphenix.fr/interview"
>

  <OceanBackground />
  <Nav />

  <main
    class="iv-main"
    id="iv-root"
    data-api={STRAVA_API_BASE}
    data-form={GOOGLE_FORM_URL}
  >

    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="iv-hero">
      <div class="iv-badge">
        <i class="fas fa-bicycle"></i> Tour de la Data 2026
      </div>
      <h1 class="iv-title">Rencontrons-nous<br><span class="iv-title-accent">sur la route</span></h1>
      <p class="iv-sub">
        Je réalise un tour de France à vélo dédié à la <strong>Data &amp; l'IA</strong>.<br>
        Je rencontre des équipes data, des DSI, des fondateurs de startups — sur le terrain.
      </p>
    </section>

    <!-- ── Position live ──────────────────────────────────── -->
    <section class="iv-section">
      <div class="iv-card iv-card--pos" id="pos-card">
        <div class="iv-pos-header">
          <span class="iv-live-dot" aria-label="Position live"></span>
          <span class="iv-pos-label">Dernière position connue</span>
          <button class="iv-refresh-btn" id="pos-refresh" aria-label="Actualiser la position">
            <i class="fas fa-rotate-right"></i>
          </button>
        </div>
        <div class="iv-pos-body" id="pos-body">
          <div class="iv-pos-loading">
            <i class="fas fa-spinner fa-spin"></i> Localisation en cours…
          </div>
        </div>
      </div>
    </section>

    <!-- ── Concept 3 lignes ───────────────────────────────── -->
    <section class="iv-section">
      <div class="iv-pitch">
        <div class="iv-pitch-item">
          <div class="iv-pitch-icon"><i class="fas fa-route"></i></div>
          <div class="iv-pitch-text">
            <strong>4 000 km à vélo</strong> à travers la France — Data hubs, tech clusters, meetups, salons.
          </div>
        </div>
        <div class="iv-pitch-item">
          <div class="iv-pitch-icon"><i class="fas fa-people-group"></i></div>
          <div class="iv-pitch-text">
            <strong>Rencontres terrain</strong> avec des équipes data, DSI, fondateurs, architectes, data scientists.
          </div>
        </div>
        <div class="iv-pitch-item">
          <div class="iv-pitch-icon"><i class="fas fa-chart-line"></i></div>
          <div class="iv-pitch-text">
            <strong>Retour d'expérience pragmatique</strong> — 15 ans en Data Product Management, BI, production IT.
          </div>
        </div>
      </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────────── -->
    <section class="iv-section iv-cta-section">
      <a
        id="iv-form-btn"
        href={GOOGLE_FORM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="iv-btn-primary"
      >
        <i class="fas fa-calendar-check"></i>
        Demander un entretien
      </a>
      <p class="iv-cta-hint">Formulaire · 2 min · Réponse sous 48 h</p>
    </section>

    <!-- ── Footer dédié ───────────────────────────────────── -->
    <footer class="iv-footer">
      <div class="iv-footer-links">
        <a href="https://cal.com/stephane-celton" target="_blank" rel="noopener" class="iv-footer-link">
          <i class="fas fa-calendar-days"></i> Réserver un créneau — Cal.com
        </a>
        <a href="mailto:stephane@oceanphenix.fr" class="iv-footer-link">
          <i class="fas fa-envelope"></i> stephane@oceanphenix.fr
        </a>
        <a href="https://tourdata2026.oceanphenix.fr" target="_blank" rel="noopener" class="iv-footer-link">
          <i class="fas fa-bicycle"></i> tourdata2026.oceanphenix.fr
        </a>
      </div>
      <p class="iv-footer-copy">© 2025–2026 <strong>OceanPhenix™</strong> · Stéphane Celton</p>
    </footer>

  </main>

  <CguModal />

</BaseLayout>

<!-- ── Script position ────────────────────────────────────── -->
<script is:inline>
(function () {
  'use strict';

  var root = document.getElementById('iv-root');
  var API_BASE = (root && root.dataset.api) || 'https://goal.oceanphenix.fr';

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function formatDate(str) {
    if (!str) return '';
    try {
      return new Date(str).toLocaleString('fr-FR', {
        day: 'numeric', month: 'long', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      });
    } catch(e) { return str; }
  }

  function renderPos(data) {
    var body = document.getElementById('pos-body');
    if (!body) return;

    if (!data || data.error) {
      body.innerHTML =
        '<p class="iv-pos-err"><i class="fas fa-circle-exclamation"></i> Position temporairement indisponible.</p>';
      return;
    }

    // Support plusieurs formats de réponse possibles
    var ville   = data.city   || data.ville  || data.location || '';
    var region  = data.region || data.departement || '';
    var pays    = data.country || data.pays  || 'France';
    var lat     = data.lat    || data.latitude  || null;
    var lon     = data.lon    || data.longitude || null;
    var updAt   = data.updatedAt || data.timestamp || data.updated_at || '';
    var activite = data.activity || data.activite || '';

    var lines = [];
    if (ville)   lines.push('<span class="iv-pos-city">' + escHtml(ville) + (region ? ' · ' + escHtml(region) : '') + '</span>');
    if (pays && pays !== 'France') lines.push('<span class="iv-pos-country">' + escHtml(pays) + '</span>');
    if (activite) lines.push('<span class="iv-pos-act"><i class="fas fa-bicycle"></i> ' + escHtml(activite) + '</span>');
    if (updAt)   lines.push('<span class="iv-pos-date"><i class="fas fa-clock"></i> ' + escHtml(formatDate(updAt)) + '</span>');
    if (lat && lon) {
      var osmUrl = 'https://www.openstreetmap.org/?mlat=' + lat + '&mlon=' + lon + '&zoom=12';
      lines.push('<a href="' + osmUrl + '" target="_blank" rel="noopener" class="iv-pos-map"><i class="fas fa-map-location-dot"></i> Voir sur la carte</a>');
    }

    body.innerHTML = lines.length
      ? '<div class="iv-pos-info">' + lines.join('') + '</div>'
      : '<p class="iv-pos-err">Données de position incomplètes.</p>';
  }

  function fetchPos() {
    var body = document.getElementById('pos-body');
    if (body) body.innerHTML = '<div class="iv-pos-loading"><i class="fas fa-spinner fa-spin"></i> Localisation en cours…</div>';

    fetch(API_BASE + '/api/strava-position', { cache: 'no-cache' })
      .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(renderPos)
      .catch(function() { renderPos(null); });
  }

  var refreshBtn = document.getElementById('pos-refresh');
  if (refreshBtn) refreshBtn.addEventListener('click', fetchPos);

  fetchPos();
})();
</script>

<style>
  /* ── Layout principal ──────────────────────────────────── */
  .iv-main {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    padding: 6rem 1.5rem 4rem;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .iv-hero { text-align: center; }

  .iv-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 1.1rem;
    border-radius: 50px;
    border: 1px solid rgba(77, 184, 212, 0.25);
    background: rgba(77, 184, 212, 0.06);
    color: var(--accent-cyan);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 1.4rem;
  }

  .iv-title {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-light);
    margin: 0 0 1rem;
  }
  .iv-title-accent { color: var(--heading-color); }

  .iv-sub {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto;
  }
  .iv-sub strong { color: var(--text-light); }

  /* ── Sections ─────────────────────────────────────────── */
  .iv-section { width: 100%; }

  /* ── Card position ────────────────────────────────────── */
  .iv-card {
    background: rgba(10, 25, 41, 0.85);
    border: 1px solid rgba(62, 148, 180, 0.18);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
  }

  .iv-pos-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  /* Point live pulsant */
  .iv-live-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-cyan);
    flex-shrink: 0;
  }
  .iv-live-dot::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--accent-cyan);
    opacity: 0;
    animation: iv-pulse 2.2s ease-out infinite;
  }
  .iv-live-dot::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid var(--accent-cyan);
    opacity: 0;
    animation: iv-pulse 2.2s ease-out 0.5s infinite;
  }

  @keyframes iv-pulse {
    0%   { transform: scale(0.6); opacity: 0.7; }
    80%  { transform: scale(1.8); opacity: 0; }
    100% { opacity: 0; }
  }

  .iv-pos-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex: 1;
  }

  .iv-refresh-btn {
    background: none;
    border: 1px solid rgba(77, 184, 212, 0.2);
    color: var(--text-muted);
    border-radius: 6px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.75rem;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .iv-refresh-btn:hover { color: var(--accent-cyan); border-color: rgba(77, 184, 212, 0.45); }

  .iv-pos-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.2rem;
  }
  .iv-pos-city {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-light);
  }
  .iv-pos-country { font-size: 0.85rem; color: var(--text-muted); }
  .iv-pos-act     { font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.35rem; }
  .iv-pos-date    { font-size: 0.78rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.35rem; }
  .iv-pos-map     {
    font-size: 0.78rem;
    color: var(--accent-cyan);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }
  .iv-pos-map:hover { opacity: 1; }

  .iv-pos-loading, .iv-pos-err {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .iv-pos-err { color: rgba(239, 68, 68, 0.75); }

  /* ── Pitch 3 lignes ───────────────────────────────────── */
  .iv-pitch {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .iv-pitch-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(10, 25, 41, 0.6);
    border: 1px solid rgba(62, 148, 180, 0.12);
    border-radius: 10px;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .iv-pitch-item:hover {
    border-color: rgba(77, 184, 212, 0.25);
    background: rgba(10, 25, 41, 0.85);
  }

  .iv-pitch-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(77, 184, 212, 0.08);
    border: 1px solid rgba(77, 184, 212, 0.18);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .iv-pitch-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    padding-top: 0.1rem;
  }
  .iv-pitch-text strong { color: var(--text-light); }

  /* ── CTA ──────────────────────────────────────────────── */
  .iv-cta-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .iv-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 2.2rem;
    border-radius: 50px;
    background: rgba(77, 184, 212, 0.1);
    border: 1px solid rgba(77, 184, 212, 0.4);
    color: var(--accent-cyan);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }
  .iv-btn-primary:hover {
    background: rgba(77, 184, 212, 0.18);
    border-color: rgba(77, 184, 212, 0.7);
    box-shadow: 0 0 24px rgba(77, 184, 212, 0.15);
  }

  .iv-cta-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
    opacity: 0.7;
  }

  /* ── Footer dédié ─────────────────────────────────────── */
  .iv-footer {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid rgba(62, 148, 180, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .iv-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .iv-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .iv-footer-link:hover { color: var(--accent-cyan); }
  .iv-footer-link i { font-size: 0.75rem; opacity: 0.7; }

  .iv-footer-copy {
    font-size: 0.72rem;
    color: var(--text-muted);
    opacity: 0.5;
    margin: 0;
  }

  /* ── Light theme ──────────────────────────────────────── */
  :global([data-theme="light"]) .iv-card {
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(6, 182, 212, 0.15);
  }
  :global([data-theme="light"]) .iv-pitch-item {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(6, 182, 212, 0.12);
  }
  :global([data-theme="light"]) .iv-pitch-item:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(6, 182, 212, 0.28);
  }
  :global([data-theme="light"]) .iv-footer {
    border-top-color: rgba(6, 182, 212, 0.12);
  }

  /* ── Mobile ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    .iv-main { padding: 5rem 1rem 3rem; gap: 2rem; }
    .iv-btn-primary { width: 100%; justify-content: center; }
    .iv-pos-info { flex-direction: column; gap: 0.35rem; }
    .iv-footer-links { flex-direction: column; align-items: center; }
  }
</style>
