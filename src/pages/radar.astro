---
// src/pages/radar.astro — Radar Terrain TourData 2026
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CguModal from '../components/CguModal.astro';
import OceanBackground from '../components/OceanBackground.astro';
---

<BaseLayout
  title="Radar Terrain — En développement | TourData 2026"
  description="Outil de localisation terrain en cours de développement — campings, coworkings, entreprises data/IT. TourData 2026 — Stéphane Celton."
  lastModified="22/03/2026 12:00"
>
  <OceanBackground />
  <Nav />

  <main class="rd-wip-page main-content">

    <div class="rd-wip-container">

      <!-- Badge -->
      <div class="rd-wip-badge">
        <span class="rd-wip-dot"></span>
        En développement
      </div>

      <!-- Icône principale -->
      <div class="rd-wip-icon">
        <i class="fas fa-crosshairs"></i>
      </div>

      <!-- Titre -->
      <h1 class="rd-wip-title">Radar Terrain</h1>
      <p class="rd-wip-sub">
        Outil de localisation en temps réel — campings, coworkings,<br>
        entreprises Data&nbsp;/&nbsp;IT et événements IT autour de votre position GPS.
      </p>

      <!-- Barre de progression -->
      <div class="rd-wip-progress-wrap" aria-label="Avancement">
        <div class="rd-wip-progress-bar">
          <div class="rd-wip-progress-fill" style="width: 72%"></div>
        </div>
        <span class="rd-wip-progress-label">72 % — intégration API en cours</span>
      </div>

      <!-- Fonctionnalités prévues -->
      <ul class="rd-wip-features">
        <li class="done">
          <i class="fas fa-check-circle"></i>
          <span><strong>Carte interactive</strong> Leaflet + OpenStreetMap</span>
        </li>
        <li class="done">
          <i class="fas fa-check-circle"></i>
          <span><strong>Campings</strong> via OpenDataSoft / Atout France</span>
        </li>
        <li class="done">
          <i class="fas fa-check-circle"></i>
          <span><strong>Coworkings</strong> via OpenStreetMap / Overpass</span>
        </li>
        <li class="done">
          <i class="fas fa-check-circle"></i>
          <span><strong>Entreprises Data / IT</strong> via INSEE SIRENE</span>
        </li>
        <li class="wip">
          <i class="fas fa-circle-half-stroke"></i>
          <span><strong>Événements IT / Emploi</strong> via OpenAgenda</span>
        </li>
        <li class="todo">
          <i class="fas fa-circle"></i>
          <span><strong>Mode hors-ligne</strong> — cache local itinéraire</span>
        </li>
      </ul>

      <!-- CTA -->
      <div class="rd-wip-actions">
        <a href="/terrain" class="rd-wip-btn rd-wip-btn--primary">
          <i class="fas fa-bicycle"></i> Journal de terrain
        </a>
        <a href="/tourdata" class="rd-wip-btn rd-wip-btn--ghost">
          <i class="fas fa-chart-pie"></i> Dashboard
        </a>
      </div>

    </div>

    <footer class="rd-wip-footer">
      <span>TourData 2026 · OceanPhenix</span>
      <span class="rd-wip-footer-sep">·</span>
      <a href="#" id="cgu-link" class="rd-wip-footer-link">CGU &amp; RGPD</a>
    </footer>

  </main>

  <CguModal />

  <style is:global>
  .rd-wip-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - 5rem);
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .rd-wip-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 560px;
    width: 100%;
    gap: 1.5rem;
  }

  /* Badge */
  .rd-wip-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0.35rem 1rem;
    background: rgba(77, 184, 212, 0.07);
    border: 1px solid rgba(77, 184, 212, 0.22);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-cyan);
  }
  .rd-wip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
    animation: wip-pulse 2s ease infinite;
    flex-shrink: 0;
  }
  @keyframes wip-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }

  /* Icône */
  .rd-wip-icon {
    width: 72px;
    height: 72px;
    background: rgba(77, 184, 212, 0.06);
    border: 1px solid rgba(77, 184, 212, 0.2);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: rgba(77, 184, 212, 0.65);
  }

  /* Titre */
  .rd-wip-title {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-weight: 700;
    color: var(--heading-color, #e2eef6);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .rd-wip-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Barre progression */
  .rd-wip-progress-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .rd-wip-progress-bar {
    width: 100%;
    height: 4px;
    background: rgba(77, 184, 212, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }
  .rd-wip-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #3a9ab8, #4db8d4);
    border-radius: 2px;
    transition: width .6s ease;
  }
  .rd-wip-progress-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Liste fonctionnalités */
  .rd-wip-features {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    background: rgba(12, 22, 40, 0.6);
    border: 1px solid rgba(45, 130, 170, 0.12);
    border-radius: 10px;
    overflow: hidden;
  }
  .rd-wip-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(45, 130, 170, 0.07);
    text-align: left;
  }
  .rd-wip-features li:last-child { border-bottom: none; }
  .rd-wip-features li span { color: var(--text-muted); }
  .rd-wip-features li strong { color: var(--text-light, #e2eef6); font-weight: 500; }

  .rd-wip-features li.done i { color: #3de8a0; font-size: 0.85rem; flex-shrink: 0; }
  .rd-wip-features li.wip  i { color: #f59e0b; font-size: 0.85rem; flex-shrink: 0; }
  .rd-wip-features li.todo i { color: rgba(143,163,184,.3); font-size: 0.85rem; flex-shrink: 0; }
  .rd-wip-features li.todo span { opacity: 0.45; }

  /* Boutons */
  .rd-wip-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }
  .rd-wip-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0.6rem 1.4rem;
    border-radius: 7px;
    font-size: 0.88rem;
    font-weight: 600;
    font-family: var(--font-primary);
    text-decoration: none;
    cursor: pointer;
    transition: background .18s, border-color .18s, color .18s;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .rd-wip-btn--primary {
    background: var(--accent-cyan);
    color: #071018;
    border-color: var(--accent-cyan);
  }
  .rd-wip-btn--primary:hover { background: #5bc4de; border-color: #5bc4de; }
  .rd-wip-btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border-color: rgba(45, 130, 170, 0.25);
  }
  .rd-wip-btn--ghost:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); }

  /* Footer */
  .rd-wip-footer {
    margin-top: auto;
    padding-top: 2.5rem;
    font-size: 0.72rem;
    color: rgba(143, 163, 184, 0.45);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rd-wip-footer-sep { opacity: 0.4; }
  .rd-wip-footer-link {
    color: rgba(143, 163, 184, 0.45);
    text-decoration: none;
    transition: color .15s;
  }
  .rd-wip-footer-link:hover { color: var(--accent-cyan); }

  /* Light mode */
  [data-theme="light"] .rd-wip-features { background: rgba(255,255,255,.8); border-color: rgba(26,127,160,.12); }
  [data-theme="light"] .rd-wip-features li { border-bottom-color: rgba(26,127,160,.07); }
  [data-theme="light"] .rd-wip-features li strong { color: #1a2535; }
  [data-theme="light"] .rd-wip-title { color: #1a2535; }
  [data-theme="light"] .rd-wip-btn--primary { color: #fff; }
  </style>

</BaseLayout>
